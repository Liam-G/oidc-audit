{
  "id": "fresh-clean-realm",
  "realm": "fresh-clean-realm",
  "enabled": true,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": false,
  "clients": [
    {
      "clientId": "account",
      "name": "${client_account}",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/fresh-clean-realm/account/",
      "redirectUris": ["/realms/fresh-clean-realm/account/*"],
      "enabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect",
      "attributes": {"realm_client": "false", "post.logout.redirect.uris": "+"}
    },
    {
      "clientId": "account-console",
      "name": "${client_account-console}",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/fresh-clean-realm/account/",
      "redirectUris": ["/realms/fresh-clean-realm/account/*"],
      "enabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect",
      "attributes": {"pkce.code.challenge.method": "S256", "realm_client": "false"}
    },
    {
      "clientId": "admin-cli",
      "name": "${client_admin-cli}",
      "enabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [],
      "attributes": {"realm_client": "true"}
    },
    {
      "clientId": "broker",
      "name": "${client_broker}",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [],
      "attributes": {"realm_client": "true"}
    },
    {
      "clientId": "realm-management",
      "name": "${client_realm-management}",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [],
      "attributes": {"realm_client": "true"}
    },
    {
      "clientId": "security-admin-console",
      "name": "${client_security-admin-console}",
      "rootUrl": "${authAdminUrl}",
      "baseUrl": "/admin/fresh-clean-realm/console/",
      "redirectUris": ["/admin/fresh-clean-realm/console/*"],
      "enabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect",
      "attributes": {"pkce.code.challenge.method": "S256", "realm_client": "true"}
    }
  ]
}
